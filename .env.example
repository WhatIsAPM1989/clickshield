# Docker Compose reads this file. The Go binary requires exported variables.
# Generate each password/token separately: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# openssl rand -base64 32
ENCRYPTION_KEY=
COOKIE_SECURE=false # true за production HTTPS proxy
TRUST_PROXY_HEADERS=false # true только за доверенным proxy
OUTCOME_API_TOKEN=replace-with-a-long-random-server-token
ALERT_WEBHOOK_URL=

BOOTSTRAP_PROJECT_NAME=My site
BOOTSTRAP_PROJECT_KEY=pk_replace_with_random_public_key
BOOTSTRAP_ALLOWED_ORIGINS=http://localhost:8081

YANDEX_COUNTER_ID=
YANDEX_MEASUREMENT_TOKEN=
GOOGLE_MEASUREMENT_ID=
GOOGLE_API_SECRET=

RAW_EVENTS_TTL=168h
AGGREGATE_TTL=4320h
STALE_SESSION_AFTER=30m
FINISH_GRACE=20s

# Optional native GeoIP2/GeoLite2 City MMDB, mount this path in the container.
GEOIP_CITY_DATABASE=
# MCP endpoint at /mcp; access needs an API token from the «API и MCP» panel.
MCP_ENABLED=true
ASN_DATABASE=/app/ip2asn.tsv.gz

# Optional S3-compatible storage for replay. Use a private bucket.
# Endpoint is an origin without a path; use the address reachable from containers.
REPLAY_S3_ENDPOINT=
REPLAY_S3_BUCKET=
REPLAY_S3_ACCESS_KEY=
REPLAY_S3_SECRET_KEY=
REPLAY_S3_REGION=us-east-1
